Algoritmo 	PrimerProgramaOperadoresArit1.0
//Son la suma, resta,divicion, multiplicasion. 
	//Definir variables 
	Definir a Como Entero; //Como se definio como entero los datos que se aceptan son los numeros enteros [1,2,3,4....]
	Definir b Como Entero;
	//Creamos otra variable llamada Suma 
	Definir suma Como Entero; //suma va hacer la suma de a + b, Variable suma es entero por que a + b lo son.
	//Asignamos vaalores a (a) y (b).
	a<-8; //el ; solo marca el final de cada instrucción
	b<-6; 
	//Para que las variables se puedan sumar deben ser del mismo tipo.
	//suma toma el valor de a+b
	suma<-a+b;
	Escribir "La suma es: ",suma;
	
	
FinAlgoritmo
