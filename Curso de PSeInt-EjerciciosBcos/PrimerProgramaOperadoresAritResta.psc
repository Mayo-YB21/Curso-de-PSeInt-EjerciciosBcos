Algoritmo 	PrimerProgramaOperadoresAritMultiplicasion
	//Son la suma, resta,divicion, multiplicasion. 
	//Definir variables 
	Definir a Como Entero; //Como se definio como entero los datos que se aceptan son los numeros enteros [1,2,3,4....]
	Definir b Como Entero;
	Escribir "Ingresa el valor de a";
	//Creamos otra variable llamada multiplicasion 
	Definir mult Como Entero; 
	Leer a;
	Escribir "Ingresa el valor de b";
	Leer b; 
	mult<-a*b;//La multiplicasion NO SE REPRESENTA POR (X), es incorrecto , la REPRESENTACION ES (*).
	Escribir "La mult es: ",mult;
	
	
FinAlgoritmo