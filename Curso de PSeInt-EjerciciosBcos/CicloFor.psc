Algoritmo CicloFor
//Es un una secuencia que se repite hasta que se cumpla una condicion, cuando se cumple esa condicion la secuencia termina.	
	Definir x Como Entero; //For es para  
	Escribir "Por favor ingrese un número máximo";
	Leer x;
	Para x <-1 Hasta x Hacer //A la primer x se le asigna el valor para que desde ahi inicie. El segundo x es el limete que ponemos para que se cumpla el siclo.
		Escribir x;
	FinPara
	
FinAlgoritmo
