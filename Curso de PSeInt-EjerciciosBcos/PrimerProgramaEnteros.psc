Algoritmo 	PrimerPrograma
	Definir num1 Como Entero; 
	Definir num2 Como Entero; //Definimos variables 
	Escribir "Ingresa el numero 1"; Escribir "Ingresa el numero 2"; //Se le pide al ususario que ingrese informacion ,y ahi se le estadando una valor
	Leer num1; //Aqui se pone la informacion y se leda el valor del num1 
	Leer num2; //Aqui tambien 
	Escribir "El numero 1 es: ",num1; //num1 se lepone ahi porque en leer se le accina el dato, y el programa estara encargado de leer los valores asignados 
	Escribir "El numero 2 es: " num2; 
FinAlgoritmo
