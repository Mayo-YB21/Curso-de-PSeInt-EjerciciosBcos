Algoritmo PrecioFinal //Este se me ccolplico por que yo queria ser algo donde se le preguntara al usuario el precio, pero creo me complique de mas. No me gusto jejeje
	Definir Prec Como Real; 
	Definir Desc Como Real; 
	Definir PrecTot Como Real;
	Prec<-150;
	Desc<- Prec*0.2;
	PrecTot <- Prec-Desc;
	Escribir "Tu precio es de: ", Prec " Pesos";
	Escribir "Tu descuento es de: ", Desc " Pesos"; 
	Escribir "Tu precio total es de: ", PrecTot " Pesos";
FinAlgoritmo
