Algoritmo CalcularElArea
	Definir Are Como Real; //Defini el are, base , altura como real por si se agrega un parametro con punto decimal.
	Definir Base Como Real;
	Definir Altura Como Real;
	Escribir "Ingrese Base del Triangulo"; //Esto lo puuse para que  el ususario pueda ingresar datos 
	Leer Base;//Aqui el programa lo lee y guarda el dato
	Escribir "Altura del  Triangulo"; 
	Leer Altura;
	Are<- (Base * Altura)/2; //Esta formula la uso por que asi le asigno que el Are es igual a base por altura entre 2, esto asi que todos los datos que el usuario ingrese usen la misma formula.
	Escribir "Tu area es: " Are; //Definiendo a que es igual el are , se jala asi aqui para que el programa en automatico sepa a que es igual. 
	
FinAlgoritmo
