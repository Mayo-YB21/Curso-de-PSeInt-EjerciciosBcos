Algoritmo precioDescuento5
	Definir prec Como Reales;//un poco facil, me complique pensando la formula del descuento cuando en el ejercicio no me la piden 
	Escribir "Ingrese el precio del producto";
	Leer prec;
	
	Si prec >= 50 Entonces //Declare cuando habra un descuento, y que mensaje saldra si hay algun descuento 
		Escribir "Tienes un descuento del 5%";
	SiNo //Tambien puse que pasara si no cumples con el parametro para descuento 
		Escribir "No hay descuento puta";
	FinSi
	
	
	
	
FinAlgoritmo
