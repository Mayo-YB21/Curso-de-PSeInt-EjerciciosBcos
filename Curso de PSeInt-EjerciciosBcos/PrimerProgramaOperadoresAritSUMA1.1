Algoritmo 	PrimerProgramaOperadoresAritResta
	//Son la suma, resta,divicion, multiplicasion. 
	//Definir variables 
	Definir a Como Entero; //Como se definio como entero los datos que se aceptan son los numeros enteros [1,2,3,4....]
	Definir b Como Entero;
	Escribir "Ingresa el valor de a";
	//Creamos otra variable llamada Resta
	Definir resta Como Entero; //Resta va hacer la resta de a - b, Variable resta es entero por que a - b lo son.
	Leer a;
	Escribir "Ingresa el valor de b";
	Leer b; 
	resta<-a-b;
	Escribir "La resta es: ",resta;
	
	
FinAlgoritmo